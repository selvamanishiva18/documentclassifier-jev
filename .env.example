# Required: Jev (TypeSafe System One) — the server refuses to start without it.
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-latest              # pin e.g. jev-1.13.0 for reproducible confidence values

# Optional: enables Precise mode (Claude Haiku 4.5).
ANTHROPIC_API_KEY=
# HAIKU_MODEL=claude-haiku-4-5-20251001

# Limits (defaults shown)
# MAX_FILE_SIZE_MB=10
# MAX_FILES_PER_BATCH=20
# MAX_PDF_PAGES=20
# CLASSIFICATION_TEXT_CAP=20000
# BATCH_TTL_MINUTES=15
# MAX_CONCURRENT_BATCHES=5

# ALLOWED_ORIGINS=http://localhost:5173
# TESSERACT_CMD=tesseract
# LOG_LEVEL=INFO
