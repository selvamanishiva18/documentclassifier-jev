# Vercel container Function for the frontend (see vercel.json). Local Docker uses ./Dockerfile instead.
# Vercel rewrites route /api/* to the backend service, so nginx here only serves the static bundle.

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ENV VITE_API_BASE_URL=/api
RUN npm run build

FROM nginx:1.27-alpine
# The nginx image renders /etc/nginx/templates/*.template with envsubst at start-up, so $PORT is applied then.
ENV PORT=80
COPY nginx.vercel.conf /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
